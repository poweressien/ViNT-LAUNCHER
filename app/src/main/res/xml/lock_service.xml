<?xml version="1.0" encoding="utf-8"?>
<!-- No accessibilityEventTypes on purpose: the service subscribes to no events and reads no content.
     It exists only to call GLOBAL_ACTION_LOCK_SCREEN. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/lock_service_desc"
    android:settingsActivity="com.bluemimicry.launcher.MainActivity" />
